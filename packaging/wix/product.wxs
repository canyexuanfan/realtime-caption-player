<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!--
    RealtimeCaptionPlayer 安装包主 wxs（WiX v3）。
    运行时目录（含 ffmpeg/mpv/sherpa DLL + ASR 模型 + player_app.exe + Qt6）由
    cmake/RcpBundle.cmake 生成到 out/bundle/runtime，再用 heat 走 -var var.RuntimeSource
    harvest 成 files.wxs（组件组 RcpRuntimeComponents，安装到 INSTALLFOLDER）。
    本文件负责 Product/Package 元数据、目录骨架、开始菜单/桌面快捷方式。
  -->
  <Product
      Id="*"
      Name="RealtimeCaptionPlayer"
      Language="1033"
      Version="0.1.0"
      Manufacturer="Rcp"
      UpgradeCode="6E6B4C1A-2F3A-4B8C-9D1E-5A7B2C3D4E5F">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of RealtimeCaptionPlayer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WixUI_InstallDir：显示许可协议 → 目录选择 → 确认安装 → 进度条 -->
    <UIRef Id="WixUI_InstallDir" />
    <!-- 跳过许可证对话框（MVP 暂不展示 EULA），直接从目录选择开始 -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- 用户点 Change 选目录后，自动追加 \RealtimeCaptionPlayer 子文件夹。
         使用 JScript（非 VBScript）：VBScript 在 perMachine(UAC提权) 安装中易触发 Error 1721。
         仅挂载在按钮级 Publish（不排进 UI/Execute 序列），避免在 AppSearch 阶段过早执行。 -->
    <Binary Id="EnsureAppSubfolder_js" SourceFile="$(var.SourceDirPath)/EnsureAppSubfolder.js" />
    <CustomAction Id="EnsureAppSubfolder"
                  BinaryKey="EnsureAppSubfolder_js"
                  JScriptCall="EnsureAppSubfolder"
                  Execute="immediate" />

    <UI>
      <!-- ① 浏览对话框选完目录点 OK 时：立即追加子文件夹，回到目录页时显示已修正的路径 -->
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction"
               Value="EnsureAppSubfolder" Order="999">1</Publish>
      <!-- ② 目录选择页 Next 按钮：安全兜底（确保最终安装路径正确） -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction"
               Value="EnsureAppSubfolder" Order="3">1</Publish>
    </UI>

    <Feature Id="Complete" Title="RealtimeCaptionPlayer" Level="1">
      <ComponentGroupRef Id="RcpRuntimeComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RealtimeCaptionPlayer" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="RealtimeCaptionPlayer">
          <Component Id="StartMenuShortcut" Guid="*">
            <Shortcut Id="StartMenuShortcutId"
                      Name="RealtimeCaptionPlayer"
                      Description="Local-first offline realtime captioning player"
                      Target="[INSTALLFOLDER]player_app.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder"
                          Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\Rcp\RealtimeCaptionPlayer" Name="installed"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" />
    </Directory>

    <Component Id="DesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcutId"
                Name="RealtimeCaptionPlayer"
                Description="Local-first offline realtime captioning player"
                Target="[INSTALLFOLDER]player_app.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\Rcp\RealtimeCaptionPlayer" Name="desktop"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Product>
</Wix>
