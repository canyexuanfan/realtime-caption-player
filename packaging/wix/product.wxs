<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="RealtimeCaptionPlayer"
      Language="1033"
      Version="0.1.0"
      Manufacturer="Rcp"
      UpgradeCode="6E6B4C1A-2F3A-4B8C-9D1E-5A7B2C3D4E5F">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <!-- AllowSameVersionUpgrades：MVP 阶段版本号恒为 0.1.0；默认（no）时
         FindRelatedProducts 忽略同版本相关产品，重装被当成新产品并列安装
         （用户报"再次安装没有检测到已安装"根因）。yes = 每次新构建顶替旧装。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of RealtimeCaptionPlayer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Custom minimal UI: Welcome -> InstallDir -> VerifyReady -> Exit.
         NO WixUI_InstallDir, NO LicenseAgreementDlg (this build's WixUIExtension license
         binder is broken and always yields an empty LicenseText.Property -> Error 2819).
         Every dialog/control is defined here and verified via msilib so no control can
         have an empty required property. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- E(ICE20)：必需的错误对话框指定。 -->
    <Property Id="ErrorDialog" Value="RcpErrorDlg" />

    <!-- 升级检测/目录记忆：安装时把最终目录写入注册表；重装时 AppSearch 读回。
         PREVINSTALLDIR 命中且以程序名子目录结尾（防陈旧脏路径）→ 预填旧目录；
         否则回默认。此前"无条件重置默认"抹掉了记忆，用户报"重装连目录也是默认"。 -->
    <Property Id="PREVINSTALLDIR">
      <RegistrySearch Id="PrevInstallDirSearch" Root="HKLM"
                      Key="SOFTWARE\Rcp\RealtimeCaptionPlayer" Name="InstallDir" Type="raw" />
    </Property>
    <!-- Type 51：目录预填（AppSearch 之后）。条件走序列行的 Condition 列。 -->
    <CustomAction Id="SetInstallFolderDefault" Property="INSTALLFOLDER"
                  Value="[ProgramFiles64Folder]RealtimeCaptionPlayer" Execute="immediate" />
    <CustomAction Id="SetInstallFolderPrev" Property="INSTALLFOLDER"
                  Value="[PREVINSTALLDIR]" Execute="immediate" />

    <UI>
      <Property Id="DefaultUIFont" Value="DlgFont" />
      <TextStyle Id="DlgFont" FaceName="Tahoma" Size="8" />
        <!-- ErrorDialog 规范要求：指定对话框需存在且首控件为 ErrorText。 -->
      <Dialog Id="RcpErrorDlg" Width="370" Height="100" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="15" Width="330" Height="60">
          <Text>[ErrorText]</Text>
        </Control>
        <Control Id="OK" Type="PushButton" X="150" Y="70" Width="70" Height="20">
          <Text>OK</Text>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <!-- E(ICE20)：标准 FilesInUse 对话框（最小合规实现）。 -->
      <Dialog Id="FilesInUse" Width="370" Height="150" Title="[ProductName] Files in Use" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="330" Height="50">
          <Text>The following applications are using files that need to be updated. Close them and click Retry.</Text>
        </Control>
        <Control Id="FileInUseList" Type="ListBox" Property="FileInUseProcess"
                 X="20" Y="70" Width="330" Height="40" />
        <Control Id="Retry" Type="PushButton" X="60" Y="115" Width="70" Height="20" Default="yes">
          <Text>Retry</Text>
          <Publish Event="EndDialog" Value="Retry">1</Publish>
        </Control>
        <Control Id="Ignore" Type="PushButton" X="150" Y="115" Width="70" Height="20">
          <Text>Ignore</Text>
          <Publish Event="EndDialog" Value="Ignore">1</Publish>
        </Control>
        <Control Id="Exit" Type="PushButton" X="240" Y="115" Width="70" Height="20" Cancel="yes">
          <Text>Exit</Text>
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Welcome to the [ProductName] Setup</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="80">
          <Text>Local-first offline realtime captioning player.&#10;&#10;Click Next to choose where to install, then Install.</Text>
        </Control>
        <!-- 检测到既往安装时显示升级提示（PREVINSTALLDIR 由 AppSearch 填充）。 -->
        <Control Id="UpgradeDesc" Type="Text" X="20" Y="140" Width="330" Height="30">
          <Text>An existing installation was detected. It will be upgraded in place (the previous version will be replaced).</Text>
          <Condition Action="hide">NOT PREVINSTALLDIR</Condition>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17">
          <Text>Next</Text>
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17">
          <Text>Cancel</Text>
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Select Installation Folder</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="45" Width="330" Height="30">
          <Text>Where should [ProductName] be installed?</Text>
        </Control>
        <Control Id="FolderLabel" Type="Text" X="20" Y="90" Width="290" Height="15" NoPrefix="yes">
          <Text>Folder:</Text>
        </Control>
        <Control Id="Folder" Type="PathEdit" X="20" Y="105" Width="320" Height="18"
                 Property="WIXUI_INSTALLDIR" Sunken="yes" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="130" Width="80" Height="18">
          <Text>Browse...</Text>
          <Publish Event="SpawnDialog" Value="BrowseDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17">
          <Text>Back</Text>
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17">
          <Text>Next</Text>
          <!-- 提交手输路径到目录属性，再进入确认页。 -->
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17">
          <Text>Cancel</Text>
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Change Folder</Text>
        </Control>
        <!-- 标准三件套（逐项对照 WiX 官方 BrowseDlg.wxs 源码）：
             Up = DirectoryListUp / New Folder = DirectoryListNew（参数 "0"）；
             DirectoryCombo 必须订阅 IgnoreChange；Cancel 必须 Reset 恢复原值。
             此前误用不存在的事件（SetTarget/DirectoryUp/NewFolder/DirectoryComboUp）
             -> 点击即 Error 2812 (Event failed)。 -->
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="20" Y="45" Width="330" Height="80"
                 Property="WIXUI_INSTALLDIR" Indirect="yes" Fixed="yes" Remote="yes" TabSkip="no">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="20" Y="78" Width="60" Height="18">
          <Text>Up</Text>
          <Publish Event="DirectoryListUp" Value="0">1</Publish>
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="90" Y="78" Width="80" Height="18">
          <Text>New Folder</Text>
          <Publish Event="DirectoryListNew" Value="0">1</Publish>
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="102" Width="330" Height="120"
                 Property="WIXUI_INSTALLDIR" Sunken="yes" Indirect="yes" TabSkip="no" />
        <Control Id="OK" Type="PushButton" X="241" Y="243" Width="56" Height="17">
          <Text>OK</Text>
          <!-- 1) SetTargetPath：把所选路径写入 INSTALLFOLDER（方括号=间接属性规则）。
               2) SetProperty：自动追加程序名子文件夹（用户所选目录\RealtimeCaptionPlayer\）。
                  Condition 列写 "INSTALLFOLDER"：非空（浏览选中了路径）才追加。
               3) EndDialog Return：子对话框必须 Return 关闭。 -->
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
          <Publish Property="INSTALLFOLDER"
                   Value="[INSTALLFOLDER]RealtimeCaptionPlayer\" Order="2">1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="3">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17">
          <Text>Cancel</Text>
          <Publish Event="Reset" Value="0" Order="1">1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Ready to Install</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="60">
          <Text>Click Install to begin installing [ProductName] to the folder you selected.</Text>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17">
          <Text>Back</Text>
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17">
          <Text>Install</Text>
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17">
          <Text>Cancel</Text>
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Completed</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="60">
          <Text>[ProductName] has been installed successfully.</Text>
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17">
          <Text>Finish</Text>
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="CancelDlg" Width="260" Height="85" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="48" Y="15" Width="194" Height="15" NoPrefix="yes">
          <Text>Are you sure you want to cancel?</Text>
        </Control>
        <Control Id="No" Type="PushButton" X="72" Y="57" Width="56" Height="17">
          <Text>No</Text>
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Yes" Type="PushButton" X="132" Y="57" Width="56" Height="17">
          <Text>Yes</Text>
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="[ProductName] Setup" Modeless="yes">
        <!-- Modeless 是关键：序列不在此阻塞，继续进入 ExecuteAction，
             引擎在执行安装脚本时把进度推送到本对话框的订阅控件。
             此前没有进度页：点 Install 后窗口消失、677MB 包全程无窗口静默安装，
             看起来像安装器闪退（用户反馈）。 -->
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>Installing [ProductName]</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="25" NoPrefix="yes">
          <Text>Please wait while [ProductName] is being installed. This may take a minute.</Text>
        </Control>
        <Control Id="ActionText" Type="Text" X="20" Y="85" Width="330" Height="18">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="110" Width="330" Height="15" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="TimeRemaining" Type="Text" X="20" Y="132" Width="330" Height="18">
          <Subscribe Event="TimeRemaining" Attribute="Text" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes">
          <Text>Cancel</Text>
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>[ProductName] setup was interrupted</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="60">
          <Text>The installation was cancelled. Your system has not been modified. Click Finish to exit.</Text>
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes">
          <Text>Finish</Text>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20" NoPrefix="yes">
          <Text>[ProductName] setup ended prematurely</Text>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="60">
          <Text>An error occurred during installation. Your system has not been modified. Click Finish to exit and try again.</Text>
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes">
          <Text>Finish</Text>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <!-- 关键机制：NewDialog 只切换对话框，序列仍暂停在当前 Show 处；
             EndDialog Return 才恢复序列。
             Welcome 排在 CostFinalize 之后（目录管理器就绪后整条 NewDialog 链可用，
             否则 Browse OK 即 Error 2732）。
             ProgressDlg 为 Modeless：显示后序列不阻塞、直接进 ExecuteAction，
             安装脚本执行时进度实时推送到进度条（缺它则点 Install 后窗口消失、
             全程无窗口静默安装）。OnExit 三态收尾：成功 ExitDialog /
             用户取消 UserExit / 出错 FatalError。 -->
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
        <AppSearch Before="CostInitialize" />
        <Custom Action="SetInstallFolderDefault" After="AppSearch">NOT PREVINSTALLDIR</Custom>
        <Custom Action="SetInstallFolderPrev" After="AppSearch">PREVINSTALLDIR &gt;&lt; &quot;RealtimeCaptionPlayer&quot;</Custom>
        <Show Dialog="WelcomeDlg" After="CostFinalize">1</Show>
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
      </InstallUISequence>
      <!-- E(ICE20)：管理安装(admin) UI 序列同样要有完整出口链。 -->
      <AdminUISequence>
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
      </AdminUISequence>
    </UI>

    <Feature Id="Complete" Title="RealtimeCaptionPlayer" Level="1">
      <ComponentGroupRef Id="RcpRuntimeComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallDirReg" />
      <ComponentRef Id="FileAssociation" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RealtimeCaptionPlayer" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="RealtimeCaptionPlayer">
          <Component Id="StartMenuShortcut" Guid="*">
            <Shortcut Id="StartMenuShortcutId"
                      Name="RealtimeCaptionPlayer"
                      Description="Local-first offline realtime captioning player"
                      Target="[INSTALLFOLDER]player_app.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder"
                          Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\Rcp\RealtimeCaptionPlayer" Name="installed"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" />
    </Directory>

    <Component Id="DesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcutId"
                Name="RealtimeCaptionPlayer"
                Description="Local-first offline realtime captioning player"
                Target="[INSTALLFOLDER]player_app.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <!-- 与 StartMenuShortcut 一致：HKCU KeyPath（ICE57：避免组件内混用
           per-user 目录与 per-machine 注册表数据）。 -->
      <RegistryValue Root="HKCU"
                     Key="Software\Rcp\RealtimeCaptionPlayer" Name="desktop"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- 安装目录记忆：重装/升级时 AppSearch 据此预填目录（升级检测的落点）。 -->
    <Component Id="InstallDirReg" Guid="*" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="Software\Rcp\RealtimeCaptionPlayer" Name="InstallDir"
                     Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
    </Component>

    <!-- E 文件关联（T0219-T0227 第一步）：注册 Rcp.VideoFiles ProgId 并把常见
         视频扩展挂到"打开方式"列表（OpenWithProgids 不抢占默认，用户显式
         "设为默认"在应用内后续实现）。卸载时随组件移除。 -->
    <Component Id="FileAssociation" Guid="*" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Classes\Rcp.VideoFiles"
                     Value="RealtimeCaptionPlayer Video" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Classes\Rcp.VideoFiles\shell\open\command"
                     Value='"[INSTALLFOLDER]player_app.exe" "%1"' Type="string" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Classes\Rcp.VideoFiles\DefaultIcon"
                     Value="[INSTALLFOLDER]player_app.exe,0" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.mp4\OpenWithProgids"
                     Name="Rcp.VideoFiles" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.mkv\OpenWithProgids"
                     Name="Rcp.VideoFiles" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.avi\OpenWithProgids"
                     Name="Rcp.VideoFiles" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.mov\OpenWithProgids"
                     Name="Rcp.VideoFiles" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.webm\OpenWithProgids"
                     Name="Rcp.VideoFiles" Value="" Type="string" />
    </Component>

  </Product>
</Wix>
